# GradeLens settings. Copy to .env (scripts\setup.ps1 does this once) and edit.
# Relative paths are resolved against this project folder. Never commit .env.

# --- Inputs and private storage (all ignored by git) ---
CSV_PATH=./cs1_scores_anon.csv
SA1_PATH=./SA1
PRIVATE_DATA_DIR=./data/private
# DATABASE_URL defaults to sqlite:///<PRIVATE_DATA_DIR>/gradelens.db
# DATABASE_URL=
DATASET_KEY=cs1
ASSESSMENT_NAME=SA1
# Full-match rule: the leading S-number is the identity; any suffix is ignored.
FILENAME_ID_REGEX=^(?P<student_id>S[0-9]+)(?:_.*)?\.py$

# --- Local models (Ollama). Roles are independently configurable. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
ANALYST_PROVIDER=ollama
ANALYST_MODEL=qwen3.5:4b-q4_K_M
REVIEWER_PROVIDER=ollama
REVIEWER_MODEL=qwen3.5:4b-q4_K_M
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=8192
# auto = send think=false when the model reports a "thinking" capability
OLLAMA_THINK=auto
ANALYST_MAX_OUTPUT_TOKENS=2048
REVIEWER_MAX_OUTPUT_TOKENS=3072
MAX_CONCURRENT_GENERATIONS=1

# --- Retrieval and review budget ---
RETRIEVAL_TOP_K_PER_CHANNEL=5
INITIAL_REVIEW_PAIR_BUDGET=30

# --- Cloud reviewer (off by default; local-only) ---
# To use Claude as the reviewer later, set all four lines below explicitly.
# The analyst and embeddings can stay local.
ALLOW_CLOUD_INFERENCE=false
ANTHROPIC_API_KEY=
# REVIEWER_PROVIDER=anthropic
# REVIEWER_MODEL=<available-Claude-model-ID-supporting-structured-outputs>
ANTHROPIC_EFFORT=high

# --- Mock provider (explicit opt-in only; outputs are labeled MOCK) ---
# Setting a *_PROVIDER to mock on real data produces labeled placeholder output,
# never findings. The synthetic demo can select mock per run instead.
MOCK_FIXTURE_DIR=./fixtures/synthetic/demo/scripted

# --- Server (loopback only) ---
HOST=127.0.0.1
PORT=8000
ACTOR_NAME=local-instructor
